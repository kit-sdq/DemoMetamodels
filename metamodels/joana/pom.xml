<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>tools.vitruv</groupId>
		<artifactId>edu.kit.ipd.sdq.metamodels</artifactId>
		<version>${revision}</version>
	</parent>

	<artifactId>edu.kit.ipd.sdq.metamodels.joana</artifactId>

	<name>JOANA Metamodel</name>
	<description>Ecore metamodel of JOANA security annotations, including the JaMoPP Java metamodel it refers to</description>

	<properties>
		<p2.emftext-jamopp.version>latest</p2.emftext-jamopp.version>
	</properties>

	<build>
		<plugins>
			<plugin>
				<groupId>org.openntf.maven</groupId>
				<artifactId>p2-layout-resolver</artifactId>
				<extensions>true</extensions>
			</plugin>
			<plugin>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>bundle-p2-artifacts</id>
						<configuration>
							<artifactItems>
								<artifactItem>
									<groupId>emftext-jamopp</groupId>
									<artifactId>org.emftext.language.java</artifactId>
									<version>1.4.1.v201901100335</version>
								</artifactItem>
								<artifactItem>
									<groupId>emftext-jamopp</groupId>
									<artifactId>org.emftext.commons.layout</artifactId>
									<version>1.4.1.v201207310007</version>
								</artifactItem>
							</artifactItems>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- javadoc does not consider the output directory with the bundled classes -->
			<plugin>
				<artifactId>maven-javadoc-plugin</artifactId>
				<configuration>
					<additionalDependencies>
						<additionalDependency>
							<groupId>emftext-jamopp</groupId>
							<artifactId>org.emftext.language.java</artifactId>
							<version>1.4.1.v201901100335</version>
						</additionalDependency>
						<additionalDependency>
							<groupId>emftext-jamopp</groupId>
							<artifactId>org.emftext.commons.layout</artifactId>
							<version>1.4.1.v201207310007</version>
						</additionalDependency>
					</additionalDependencies>
				</configuration>
			</plugin>
			<plugin>
				<artifactId>maven-failsafe-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

	<repositories>
		<repository>
			<id>emftext-jamopp</id>
			<name>EMFText and JaMoPP (P2 Wrapper)</name>
			<layout>p2</layout>
			<url>https://kit-sdq.github.io/updatesite/release/p2-wrapper/${p2.emftext-jamopp.version}/</url>
		</repository>
	</repositories>

	<pluginRepositories>
		<!-- required for the p2-layout-resolver plugin -->
		<pluginRepository>
			<id>artifactory.openntf.org</id>
			<name>artifactory.openntf.org</name>
			<url>https://artifactory.openntf.org/openntf</url>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</pluginRepository>
	</pluginRepositories>

	<dependencies>
		<dependency>
			<groupId>org.eclipse.emf</groupId>
			<artifactId>org.eclipse.emf.ecore.xmi</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
